# Ignore data & results directory contents, python virtual environments, and python cache directories
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

results/figures/*
!results/figures/.gitkeep
results/logs/*
!results/logs/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/tables/*
!results/tables/.gitkeep

.venv/
__pycache__/
# Parser outputs and tool caches
*.npz
.pytest_cache/
.ruff_cache/
*.egg-info/
